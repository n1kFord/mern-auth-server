{
    "name": "mern-auth-server",
    "version": "1.0.0",
    "description": "personal project. Express (with ES Modules) backend for a full-stack authentication system using Google and GitHub OAuth. JWT, MongoDB, rate limiting, and modular structure.",
    "main": "src/index.mjs",
    "type": "module",
    "scripts": {
        "start": "node src/index.mjs",
        "dev": "nodemon ./src/index.mjs",
        "test": "mkdir -p logs && touch logs/tests.log && truncate -s 0 logs/tests.log && NODE_ENV=test jest --forceExit --detectOpenHandles"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/n1kFord/mern-auth-server.git"
    },
    "keywords": [
        "mern-auth",
        "mern",
        "auth",
        "authentication",
        "backend",
        "express",
        "oauth",
        "google-auth",
        "github-auth",
        "jwt",
        "mongodb"
    ],
    "author": "n1kFord",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/n1kFord/mern-auth-server/issues"
    },
    "dependencies": {
        "axios": "^1.7.7",
        "bcrypt": "^5.1.1",
        "chalk": "^4.1.2",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.4.1",
        "express-validator": "^7.1.0",
        "google-auth-library": "^9.15.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.5.1",
        "nodemon": "^3.1.4",
        "prettier": "^3.3.3",
        "uuid": "^10.0.0",
        "winston": "^3.16.0"
    },
    "devDependencies": {
        "@babel/core": "^7.25.9",
        "@babel/preset-env": "^7.25.9",
        "@jest/environment": "^29.7.0",
        "babel-jest": "^29.7.0",
        "babel-plugin-transform-import-meta": "^2.2.1",
        "cross-env": "^7.0.3",
        "jest": "^29.7.0",
        "mongodb-memory-server": "^10.1.2",
        "portfinder": "^1.0.32",
        "supertest": "^7.0.0"
    }
}
